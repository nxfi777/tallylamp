{
  "manifest_version": 3,
  "name": "Tallylamp Link",
  "short_name": "Tallylamp",
  "version": "0.10.1",
  "description": "Share one tab of your browser with an AI agent on your own Tallylamp server. You pick the tab, and one click takes it back.",
  "homepage_url": "https://tallylamp.dev",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tallylamp Link",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
