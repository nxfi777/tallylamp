# Administrator secret used to log into the dashboard.
# Generate with: openssl rand -hex 32
ADMIN_SECRET=

# Public origin of this deployment, used for MCP resource metadata and cookies.
# Example: https://tallylamp-production.up.railway.app
TALLYLAMP_PUBLIC_URL=http://127.0.0.1:8080

# Listen address. Railway injects PORT. Bind 0.0.0.0 in containers.
HOST=0.0.0.0
PORT=8080

# Persistent data root (profiles, sqlite, downloads, seeds).
# Railway volume should be mounted here.
TALLYLAMP_DATA_DIR=./data

# Fleet limits
TALLYLAMP_MAX_BROWSERS=4
TALLYLAMP_IDLE_TTL_SEC=900
TALLYLAMP_ATTACHED_IDLE_TTL_SEC=14400
TALLYLAMP_HUMAN_LEASE_TTL_SEC=90
TALLYLAMP_STARTUP_TIMEOUT_SEC=45
TALLYLAMP_SHUTDOWN_TIMEOUT_SEC=15

# Chrome renderer sandbox: auto | on | off
TALLYLAMP_SANDBOX=auto

# GPU: auto | software | hardware
TALLYLAMP_GPU=auto

# Headed display. Linux containers use Xvfb. macOS uses the real display by default.
# TALLYLAMP_XVFB=1

# Chrome executable override (otherwise auto-detected).
# TALLYLAMP_CHROME_BIN=/usr/bin/google-chrome

# Allow Chrome to reach private/RFC1918 addresses (off by default).
TALLYLAMP_ALLOW_PRIVATE_NETWORK=0

# Extra Origins trusted besides the public URL (comma-separated).
# TALLYLAMP_EXTRA_ORIGINS=http://127.0.0.1:8080

# Window size for headed Chrome
TALLYLAMP_WINDOW_SIZE=1280,800

# Interaction realism overlay for chrome-devtools-mcp input tools: off | natural
TALLYLAMP_INTERACTION=off

# Advertise a local OAuth authorization server in Protected Resource Metadata.
# Some clients (notably certain Claude Code versions) prefer OAuth discovery
# over a pre-issued Authorization header when this is on.
TALLYLAMP_OAUTH=1
