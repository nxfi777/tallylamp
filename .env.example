# Copy this file to .env for *local* development only.
# Do not paste this whole file into Railway variables.

# Required. Dashboard login and OAuth consent.
# openssl rand -hex 32
ADMIN_SECRET=

# Local listen. Railway injects PORT; do not set HOST/PORT on Railway unless
# you know you need to.
HOST=0.0.0.0
PORT=8080

# Local origin. On Railway this is inferred from RAILWAY_PUBLIC_DOMAIN.
# TALLYLAMP_PUBLIC_URL=http://127.0.0.1:8080

# Local data directory. Do not set this on Railway: the volume mount
# (RAILWAY_VOLUME_MOUNT_PATH, usually /data) is used automatically.
# TALLYLAMP_DATA_DIR=./data

# Optional. OAuth for hosts that refuse a static Authorization header.
# TALLYLAMP_OAUTH=1                     # default on; discovery + /oauth/*
# TALLYLAMP_OAUTH_ACCESS_TTL_SEC=3600
# TALLYLAMP_OAUTH_REFRESH_TTL_SEC=2592000
# TALLYLAMP_OAUTH_MAX_BROWSERS=2        # cap given to a new connector agent
# TALLYLAMP_OAUTH_CLIENT_HOSTS=         # empty = any https client-metadata URL

# Optional. Accept ADMIN_SECRET as a bearer token. Off by default: it is a
# brute-forceable master key. Agent tokens are the supported bearer credential.
# TALLYLAMP_ADMIN_BEARER=0
